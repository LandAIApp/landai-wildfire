# Copy to .env (never commit .env or credentials/).

# --- Google Earth Engine -------------------------------------------------
# Cloud project registered for Earth Engine.
EE_PROJECT=
# Option A (recommended for servers/Docker): service account.
# The service account must have Earth Engine access AND read access to the
# private asset users/maikolzaraza07/mpios.
EE_SERVICE_ACCOUNT=
# Path to the JSON key. Relative paths are resolved from the working directory,
# backend/ or the repo root, e.g.  credentials/my-key.json
EE_PRIVATE_KEY_PATH=
# Option B (local development): leave both blank and run `earthengine authenticate`.

# --- API ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MUNICIPALITIES_ASSET=users/maikolzaraza07/mpios

# --- Application guards (NOT part of the V7.6 science) -------------------
MAX_AOI_HECTARES=500000
WARN_AOI_HECTARES=100000
MIN_FIRE_DATE=2018-08-01
