# Land AI Wildfire Intelligence v2 - backend configuration. Copy to .env (NEVER commit .env or key files).
EE_PROJECT=your-earth-engine-cloud-project
# Local dev: leave both empty after `earthengine authenticate`. Cloud Run / Docker: service-account key path.
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY_PATH=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MUNICIPALITIES_ASSET=users/maikolzaraza07/mpios

# --- AOI limits (municipality limits unchanged from v1) ---
MAX_AOI_HECTARES=500000
WARN_AOI_HECTARES=100000
MAX_CUSTOM_AOI_HECTARES=100000
WARN_CUSTOM_AOI_HECTARES=50000
MIN_CUSTOM_AOI_HECTARES=10
MAX_POLYGON_VERTICES=300

# --- Rate limits (in memory, per instance) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE=5/hour;20/day
RATE_LIMIT_EXPOSURE=10/hour;40/day
TRUST_FORWARDED_FOR=false        # set true behind Cloud Run
TRUSTED_PROXY_HOPS=1

# --- Exposure & Impact ---
MAX_EXPOSURE_AOI_HECTARES=50000
EXPOSURE_DEFAULT_BUFFER_M=500
EXPOSURE_MAX_BUFFER_M=2000
EXPOSURE_MAX_PIXELS=3000000
EXPOSURE_MAX_CONCURRENT=1
# Earth Engine memory: big areas are downloaded as tiles of at most this many pixels per side
EXPOSURE_TILE_PX=640
EXPOSURE_TILE_WORKERS=3
EXPOSURE_MAX_SECONDS=1000
ANALYSIS_REF_TTL_SECONDS=21600
# Long random string (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"). Empty = random per process.
ANALYSIS_REF_SECRET=

# OpenStreetMap / Overpass (public instance: be gentle)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Tried once each if the main instance answers 429/5xx/timeout (public shared servers; empty = no fallback)
OVERPASS_FALLBACK_ENDPOINTS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
# Large areas are queried in cells of ~this size (one huge query makes public servers time out)
OVERPASS_CELL_KM=6
OVERPASS_CELL_PAUSE_S=1
OVERPASS_MAX_CELLS=40
# Si Overpass responde 429, se espera y se reintenta el mismo servidor
OVERPASS_RATE_LIMIT_WAIT_S=10
OVERPASS_RATE_LIMIT_RETRIES=2
OVERPASS_USER_AGENT=LandAI-Wildfire-Intelligence/2.0 (+https://github.com/LandAIApp/landai-wildfire; contact: YOUR_REAL_EMAIL)

# WorldPop (optional key lives ONLY in the backend)
WORLDPOP_BASE_URL=https://api.worldpop.org
WORLDPOP_API_VERSION=v2          # v2 | v1 (v1 = publicly documented service; see docs/exposure-methodology.md)
WORLDPOP_YEAR=2020
WORLDPOP_RESOLUTION=100m
WORLDPOP_API_KEY=

# --- Cost / resource protection (all in-process; nothing is persisted, everything is lost on a restart) ---
# Manual kill switches: set to false and redeploy to stop expensive work (the UI then shows a "paused" notice).
ANALYSIS_ENABLED=true
EXPOSURE_ENABLED=true
# Heavy analyses at once on ONE instance (each holds a request thread while Earth Engine works / memory while polygons are built)
ANALYSIS_MAX_CONCURRENT=2
EXPOSURE_MAX_CONCURRENT=1
# Bounded, ephemeral caches (items x payload; payloads are bounded by the layer/vertex limits)
FOOTPRINT_CACHE_ITEMS=3
FOOTPRINT_CACHE_TTL_SECONDS=1800
EXPOSURE_CACHE_ITEMS=3
EXPOSURE_CACHE_TTL_SECONDS=1800
CACHE_MAX_ITEM_BYTES=25000000
# Live processing stages (polled by the UI)
PROGRESS_TTL_SECONDS=3600
RATE_LIMIT_PROGRESS=1200/hour

# Suggested values for the FIRST public phase (see docs/PERFORMANCE_AND_COST.md):
#   MAX_CUSTOM_AOI_HECTARES=50000  WARN_CUSTOM_AOI_HECTARES=25000  MAX_EXPOSURE_AOI_HECTARES=30000
#   EXPOSURE_MAX_PIXELS=1000000    OVERPASS_MAX_CELLS=16           OVERPASS_MAX_ELEMENTS=40000
