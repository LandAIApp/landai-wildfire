# URL of the FastAPI backend as seen from the browser
VITE_API_BASE_URL=http://localhost:8000

# Destination of the "Talk to Land AI" call-to-action shown after a result.
# Leave empty to hide the link. Example: https://your-landai-site.com/contact
VITE_LANDAI_CONTACT_URL=

# Only for GitHub Pages project sites, e.g. /landai-wildfire/  (leave empty otherwise)
VITE_BASE_PATH=
